{
    "default_threshold": 0.2,
    "use_negative_samples": true,
    "use_only_unet": false,
    "dnabert": {
        "model_path": "DNABERT-2-117M",
        "freeze_dnabert": false,
        "max_seq_length": 600,
        "hidden_size": 768,
        "dropout": 0.1
    },
    "regression_head": {
        "use_unet": true,
        "hidden_dim": 384,
        "dropout": 0.1,
        "num_layers": 2
    },
    "training": {
        "batch_size": 16,
        "learning_rate": 2e-5,
        "epochs": 100,
        "gradient_accumulation_steps": 1,
        "max_grad_norm": 1.0
    },
    "loss": {
        "focal_alpha": 0.5,
        "focal_gamma": 2.0,
        "use_regression_in_focal": true,
        "regression_weight": 0.5,
        "use_l1": true
    },
    "callbacks": {
        "early_stopping": {
            "patience": 4,
            "min_delta": 0.001
        },
        "model_checkpoint": {
            "path": "checkpoints/best_dnabert.pth",
            "monitor": "val_loss",
            "save_best_only": true
        },
        "lr_scheduler": {
            "mode": "min",
            "factor": 0.5,
            "patience": 5,
            "min_lr": 1e-7
        }
    },
    "data": {
        "merged_csv_path": "data/proceed_promoters/promoter_labeled_gaussian_600_11.csv",
        "train_ratio": 0.8,
        "val_ratio": 0.1,
        "test_ratio": 0.1,
        "random_seed": 42
    }
}
